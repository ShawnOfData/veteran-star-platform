/* ===== 全局样式 ===== */
page {
  background-color: #080c14;
  color: rgba(255,255,255,0.9);
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
}

/* ===== 通用卡片 ===== */
.card {
  background: rgba(255,255,255,0.04);
  border: 1px solid rgba(196,163,90,0.1);
  border-radius: 12rpx;
  padding: 28rpx;
  margin: 0 24rpx 20rpx;
  transition: all 0.3s ease;
}
.card:active {
  transform: scale(0.98);
  background: rgba(255,255,255,0.06);
}

/* ===== 通用按钮 ===== */
.btn-primary {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  background: #2d5a27;
  color: #fff;
  font-size: 30rpx;
  letter-spacing: 4rpx;
  border-radius: 8rpx;
  border: 1px solid #2d5a27;
  transition: all 0.3s ease;
}
.btn-primary:active {
  background: #3a6e33;
  box-shadow: 0 0 30rpx rgba(45,90,39,0.3);
}
.btn-primary:disabled {
  opacity: 0.5;
}

/* ===== 金色文字 ===== */
.text-gold {
  color: #c4a35a;
}

/* ===== 页面标题 ===== */
.page-title {
  font-size: 36rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  padding: 30rpx 32rpx 20rpx;
  color: rgba(255,255,255,0.9);
}

/* ===== 分隔线 ===== */
.divider {
  height: 1px;
  background: linear-gradient(90deg, rgba(196,163,90,0.3), transparent);
  margin: 20rpx 32rpx;
}

/* ===== 加载动画 ===== */
.loading-container {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 80rpx 0;
}
.loading-dot {
  width: 12rpx;
  height: 12rpx;
  background: rgba(196,163,90,0.4);
  border-radius: 50%;
  margin: 0 8rpx;
  animation: dotBounce 1.2s ease-in-out infinite;
}
.loading-dot:nth-child(2) { animation-delay: 0.2s; }
.loading-dot:nth-child(3) { animation-delay: 0.4s; }
@keyframes dotBounce {
  0%, 80%, 100% { transform: scale(0.6); opacity: 0.3; }
  40% { transform: scale(1); opacity: 1; }
}

/* ===== 空状态 ===== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
  color: rgba(255,255,255,0.2);
  font-size: 26rpx;
}
