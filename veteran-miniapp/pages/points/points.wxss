.points-page {
  padding-bottom: 40rpx;
}

/* ===== Header ===== */
.points-header {
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding: 48rpx 32rpx;
}

.points-total {
  text-align: center;
}

.points-value {
  font-size: 72rpx;
  font-weight: 900;
  display: block;
  font-family: 'Courier New', monospace;
}

.points-label {
  font-size: 24rpx;
  color: rgba(255,255,255,0.3);
  margin-top: 8rpx;
  display: block;
  letter-spacing: 4rpx;
}

.points-stats {
  display: flex;
  gap: 48rpx;
}

.points-stat-item {
  text-align: center;
}

.stat-val {
  font-size: 36rpx;
  font-weight: 700;
  color: rgba(255,255,255,0.7);
  display: block;
}

.stat-lbl {
  font-size: 20rpx;
  color: rgba(255,255,255,0.25);
  margin-top: 6rpx;
  display: block;
}

/* ===== Filter ===== */
.filter-bar {
  padding: 0 32rpx;
  margin-bottom: 16rpx;
}

.filter-btn {
  display: inline-block;
  padding: 12rpx 28rpx;
  font-size: 24rpx;
  color: rgba(196,163,90,0.7);
  border: 1px solid rgba(196,163,90,0.2);
  border-radius: 8rpx;
  background: rgba(196,163,90,0.05);
}

/* ===== Detail List ===== */
.detail-item {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.detail-left {
  flex: 1;
}

.detail-reason {
  font-size: 28rpx;
  color: rgba(255,255,255,0.8);
  display: block;
}

.detail-time {
  font-size: 22rpx;
  color: rgba(255,255,255,0.25);
  margin-top: 6rpx;
  display: block;
}

.detail-remark {
  font-size: 22rpx;
  color: rgba(255,255,255,0.35);
  margin-top: 4rpx;
  display: block;
}

.detail-right {
  text-align: right;
}

.detail-change {
  font-size: 36rpx;
  font-weight: 700;
  font-family: 'Courier New', monospace;
}

.detail-change.positive { color: #2d5a27; }
.detail-change.negative { color: #c0392b; }
