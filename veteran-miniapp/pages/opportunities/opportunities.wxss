.opp-page {
  padding-bottom: 40rpx;
}

/* ===== Filter Bar ===== */
.filter-bar {
  padding: 20rpx 24rpx;
  position: sticky;
  top: 0;
  z-index: 10;
  background: #080c14;
}

.filter-scroll {
  display: flex;
  gap: 16rpx;
  overflow-x: auto;
  white-space: nowrap;
  padding-bottom: 8rpx;
}
.filter-scroll::-webkit-scrollbar { display: none; }

.filter-chip {
  display: inline-block;
  padding: 12rpx 32rpx;
  font-size: 24rpx;
  color: rgba(255,255,255,0.4);
  border: 1px solid rgba(255,255,255,0.08);
  border-radius: 40rpx;
  background: rgba(255,255,255,0.03);
  flex-shrink: 0;
}
.filter-chip.active {
  color: #c4a35a;
  border-color: #c4a35a;
  background: rgba(196,163,90,0.08);
}

/* ===== Opp Cards ===== */
.opp-card {
  margin: 0 24rpx 20rpx;
}

.opp-title-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.opp-title {
  font-size: 30rpx;
  font-weight: 600;
  flex: 1;
}

.opp-status {
  font-size: 20rpx;
  padding: 4rpx 16rpx;
  border-radius: 6rpx;
}
.opp-status-1 { color: #2d5a27; background: rgba(45,90,39,0.1); }
.opp-status-4 { color: rgba(255,255,255,0.3); background: rgba(255,255,255,0.05); }

.opp-desc {
  font-size: 24rpx;
  color: rgba(255,255,255,0.45);
  margin-bottom: 16rpx;
  line-height: 1.5;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.opp-meta-row {
  display: flex;
  gap: 20rpx;
  margin-bottom: 8rpx;
}

.opp-meta {
  font-size: 22rpx;
  color: rgba(255,255,255,0.3);
}

.opp-date {
  font-size: 22rpx;
  color: rgba(255,255,255,0.2);
}
