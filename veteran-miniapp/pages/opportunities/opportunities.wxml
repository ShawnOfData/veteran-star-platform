<view class="opp-page">
  <!-- 筛选栏 -->
  <view class="filter-bar">
    <view class="filter-scroll">
      <view class="filter-chip {{typeFilter === '' ? 'active' : ''}}" data-type="" bindtap="onFilterType">全部</view>
      <view class="filter-chip {{typeFilter === 'intern' ? 'active' : ''}}" data-type="intern" bindtap="onFilterType">实习</view>
      <view class="filter-chip {{typeFilter === 'job' ? 'active' : ''}}" data-type="job" bindtap="onFilterType">就业</view>
      <view class="filter-chip {{typeFilter === 'volunteer' ? 'active' : ''}}" data-type="volunteer" bindtap="onFilterType">志愿</view>
      <view class="filter-chip {{typeFilter === 'training' ? 'active' : ''}}" data-type="training" bindtap="onFilterType">培训</view>
    </view>
  </view>

  <!-- 列表 -->
  <view class="opp-list">
    <view class="opp-card card" wx:for="{{list}}" wx:key="id" bindtap="goToDetail" data-id="{{item.id}}">
      <view class="opp-title-row">
        <text class="opp-title">{{item.title}}</text>
        <text class="opp-status opp-status-{{item.status}}">{{item.statusText}}</text>
      </view>
      <view class="opp-desc">{{item.description}}</view>
      <view class="opp-meta-row">
        <text class="opp-meta">{{item.unitName}}</text>
        <text class="opp-meta">{{item.type}}</text>
        <text class="opp-meta">{{item.currentApplied}}/{{item.demandCount}}人</text>
      </view>
      <view class="opp-date">截止：{{item.endTime}}</view>
    </view>
  </view>

  <view class="empty-state" wx:if="{{list.length === 0 && !loading}}">
    <text>暂无匹配的机会</text>
  </view>

  <view class="loading-container" wx:if="{{loading}}">
    <view class="loading-dot"></view>
    <view class="loading-dot"></view>
    <view class="loading-dot"></view>
  </view>
</view>
