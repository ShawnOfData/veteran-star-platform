.detail-page {
  padding-bottom: 160rpx;
}

/* ===== 标题卡 ===== */
.detail-card {
  margin-bottom: 20rpx;
}

.detail-title-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 20rpx;
}

.detail-title {
  font-size: 36rpx;
  font-weight: 700;
  flex: 1;
  margin-right: 16rpx;
  line-height: 1.4;
}

.opp-status {
  font-size: 20rpx;
  padding: 4rpx 16rpx;
  border-radius: 6rpx;
  flex-shrink: 0;
}
.opp-status-1 { color: #6a9b5e; background: rgba(45,90,39,0.15); }
.opp-status-4 { color: rgba(255,255,255,0.3); background: rgba(255,255,255,0.05); }

.detail-meta-row {
  display: flex;
  gap: 24rpx;
  margin-bottom: 12rpx;
}

.detail-meta {
  font-size: 24rpx;
  color: rgba(255,255,255,0.5);
}

/* ===== 描述卡 ===== */
.detail-desc-card {
  margin-bottom: 20rpx;
}

.detail-section-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #c4a35a;
  margin-bottom: 20rpx;
  letter-spacing: 2rpx;
}

.detail-desc {
  display: block;
  font-size: 26rpx;
  color: rgba(255,255,255,0.7);
  line-height: 1.8;
  word-break: break-all;
}

/* ===== 底部报名栏 ===== */
.detail-footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 24rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(8,12,20,0.95);
  border-top: 1px solid rgba(196,163,90,0.1);
  box-sizing: border-box;
}
