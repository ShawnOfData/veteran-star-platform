<view class="detail-page" wx:if="{{detail}}">
  <!-- 标题卡 -->
  <view class="card detail-card">
    <view class="detail-title-row">
      <text class="detail-title">{{detail.title}}</text>
      <text class="opp-status opp-status-{{detail.status}}">{{statusText}}</text>
    </view>
    <view class="detail-meta-row">
      <text class="detail-meta">{{detail.unitName || '未填写单位'}}</text>
      <text class="detail-meta">{{detail.type}}</text>
    </view>
    <view class="detail-meta-row">
      <text class="detail-meta">报名 {{detail.currentApplied || 0}}/{{detail.demandCount || 0}} 人</text>
      <text class="detail-meta">截止：{{detail.endTime || '长期有效'}}</text>
    </view>
  </view>

  <!-- 详情描述 -->
  <view class="card detail-desc-card">
    <text class="detail-section-title">机会详情</text>
    <text class="detail-desc">{{detail.description || '暂无详细描述'}}</text>
  </view>

  <!-- 底部报名栏 -->
  <view class="detail-footer">
    <button class="btn-primary" bindtap="handleApply"
      disabled="{{applying || detail.status !== 1 || applied}}">
      <text wx:if="{{applying}}">报名中...</text>
      <text wx:elif="{{applied}}">已报名</text>
      <text wx:elif="{{detail.status !== 1}}">不可报名</text>
      <text wx:else>立即报名</text>
    </button>
  </view>
</view>

<view class="loading-container" wx:if="{{loading}}">
  <view class="loading-dot"></view>
  <view class="loading-dot"></view>
  <view class="loading-dot"></view>
</view>

<view class="empty-state" wx:if="{{!detail && !loading}}">
  <text>机会不存在或已下架</text>
</view>
