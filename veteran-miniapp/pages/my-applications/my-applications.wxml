<view class="apply-page">
  <view class="apply-list">
    <view class="apply-card card" wx:for="{{list}}" wx:key="id">
      <view class="apply-title-row">
        <text class="apply-title">{{item.title}}</text>
        <text class="apply-status apply-status-{{item.applyStatus}}">{{item.applyStatusText}}</text>
      </view>
      <view class="apply-meta">
        <text>{{item.unitName}}</text>
        <text>{{item.type}}</text>
      </view>
      <view class="apply-time">报名时间：{{item.applyTime}}</view>
    </view>
  </view>

  <view class="empty-state" wx:if="{{list.length === 0 && !loading}}">
    <text>暂无报名记录</text>
  </view>

  <view class="loading-container" wx:if="{{loading}}">
    <view class="loading-dot"></view>
    <view class="loading-dot"></view>
    <view class="loading-dot"></view>
  </view>
</view>
