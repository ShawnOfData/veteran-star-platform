.apply-page {
  padding-bottom: 40rpx;
}

.apply-list {
  padding: 20rpx 0;
}

.apply-card {
  margin: 0 24rpx 20rpx;
}

.apply-title-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.apply-title {
  font-size: 28rpx;
  font-weight: 600;
  flex: 1;
}

.apply-status {
  font-size: 20rpx;
  padding: 4rpx 16rpx;
  border-radius: 6rpx;
}
.apply-status-0 { color: #c4a35a; background: rgba(196,163,90,0.1); }
.apply-status-1 { color: #2d5a27; background: rgba(45,90,39,0.1); }
.apply-status-2 { color: rgba(255,255,255,0.3); background: rgba(255,255,255,0.05); }

.apply-meta {
  display: flex;
  gap: 20rpx;
  font-size: 22rpx;
  color: rgba(255,255,255,0.35);
  margin-bottom: 8rpx;
}

.apply-time {
  font-size: 22rpx;
  color: rgba(255,255,255,0.2);
}
