.ranking-page {
  padding-bottom: 40rpx;
}

.ranking-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx 32rpx 24rpx;
}

.ranking-title {
  font-size: 36rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.ranking-period {
  font-size: 22rpx;
  color: rgba(255,255,255,0.3);
  padding: 8rpx 20rpx;
  border: 1px solid rgba(255,255,255,0.08);
  border-radius: 30rpx;
}

/* ===== Podium ===== */
.podium {
  display: flex;
  justify-content: center;
  align-items: flex-end;
  gap: 20rpx;
  padding: 32rpx 24rpx;
}

.podium-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  position: relative;
}

.podium-item.rank-1 {
  order: 2;
}
.podium-item.rank-2 {
  order: 1;
  transform: translateY(30rpx);
}
.podium-item.rank-3 {
  order: 3;
  transform: translateY(60rpx);
}

.podium-crown {
  font-size: 40rpx;
  color: #c4a35a;
  position: absolute;
  top: -40rpx;
}

.podium-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: rgba(196,163,90,0.1);
  border: 2rpx solid rgba(196,163,90,0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #c4a35a;
  font-weight: 600;
}

.rank-1 .podium-avatar {
  width: 100rpx;
  height: 100rpx;
  border-color: #c4a35a;
  box-shadow: 0 0 30rpx rgba(196,163,90,0.2);
}

.podium-name {
  font-size: 24rpx;
  font-weight: 500;
}

.podium-points {
  font-size: 28rpx;
  color: #c4a35a;
  font-weight: 700;
  font-family: 'Courier New', monospace;
}

.podium-rank {
  font-size: 20rpx;
  color: rgba(255,255,255,0.3);
  background: rgba(255,255,255,0.05);
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ===== Rank List ===== */
.rank-list {
  padding: 0 24rpx;
}

.rank-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 20rpx;
  border-bottom: 1px solid rgba(255,255,255,0.03);
}

.rank-number {
  width: 44rpx;
  font-size: 24rpx;
  color: rgba(255,255,255,0.3);
  text-align: center;
  font-family: 'Courier New', monospace;
}
.rank-number.top {
  color: #c4a35a;
  font-weight: 700;
}

.rank-avatar-sm {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: rgba(196,163,90,0.08);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: rgba(196,163,90,0.6);
}

.rank-info {
  flex: 1;
}

.rank-name {
  font-size: 28rpx;
  display: block;
}

.rank-college {
  font-size: 22rpx;
  color: rgba(255,255,255,0.25);
  margin-top: 4rpx;
  display: block;
}

.rank-points {
  font-size: 28rpx;
  color: #c4a35a;
  font-weight: 600;
  font-family: 'Courier New', monospace;
}

/* ===== My Rank ===== */
.my-rank {
  position: sticky;
  bottom: 0;
  padding: 0 24rpx 20rpx;
}

.my-rank-item {
  background: rgba(196,163,90,0.06);
  border: 1px solid rgba(196,163,90,0.15);
  border-radius: 12rpx;
}
