<view class="home-page">
  <!-- Banner / 公告轮播 -->
  <swiper class="banner-swiper" indicator-dots="{{true}}" indicator-color="rgba(255,255,255,0.2)" indicator-active-color="#c4a35a" autoplay interval="5000" circular>
    <swiper-item wx:for="{{announcements}}" wx:key="id">
      <view class="banner-item">
        <view class="banner-content">
          <text class="banner-title">{{item.title}}</text>
          <text class="banner-summary">{{item.summary}}</text>
        </view>
      </view>
    </swiper-item>
    <swiper-item wx:if="{{announcements.length === 0}}">
      <view class="banner-item banner-placeholder">
        <view class="banner-content">
          <text class="banner-title">戎归·星辉</text>
          <text class="banner-summary">欢迎回来，退役不退志</text>
        </view>
      </view>
    </swiper-item>
  </swiper>

  <!-- 数据卡片 -->
  <view class="stats-grid">
    <view class="stat-card">
      <text class="stat-value text-gold">{{stats.totalPoints || 0}}</text>
      <text class="stat-label">累计积分</text>
    </view>
    <view class="stat-card">
      <text class="stat-value text-gold">{{stats.serviceCount || 0}}</text>
      <text class="stat-label">服务次数</text>
    </view>
    <view class="stat-card">
      <text class="stat-value text-gold">{{stats.honorCount || 0}}</text>
      <text class="stat-label">荣誉数量</text>
    </view>
    <view class="stat-card">
      <text class="stat-value text-gold">{{stats.ranking || '-'}}</text>
      <text class="stat-label">排名</text>
    </view>
  </view>

  <!-- 快速入口 -->
  <view class="quick-actions">
    <view class="action-item" bindtap="goToPoints">
      <view class="action-icon action-icon-points">
        <text class="icon-text">★</text>
      </view>
      <text class="action-label">积分明细</text>
    </view>
    <view class="action-item" bindtap="goToOpportunities">
      <view class="action-icon action-icon-opp">
        <text class="icon-text">!</text>
      </view>
      <text class="action-label">机会报名</text>
    </view>
    <view class="action-item" bindtap="goToRanking">
      <view class="action-icon action-icon-rank">
        <text class="icon-text">#</text>
      </view>
      <text class="action-label">积分排行</text>
    </view>
    <view class="action-item" bindtap="goToProfile">
      <view class="action-icon action-icon-profile">
        <text class="icon-text">@</text>
      </view>
      <text class="action-label">个人信息</text>
    </view>
  </view>

  <!-- 近期机会 -->
  <view class="section">
    <view class="section-header">
      <text class="section-title">近期机会</text>
      <text class="section-more" bindtap="goToOpportunities">查看全部</text>
    </view>
    <view class="opportunity-list">
      <view class="opportunity-card card" wx:for="{{recentOpportunities}}" wx:key="id" bindtap="goToOpportunityDetail" data-id="{{item.id}}">
        <view class="opp-title">{{item.title}}</view>
        <view class="opp-meta">
          <text class="opp-meta-item">{{item.type}}</text>
          <text class="opp-meta-item">{{item.unitName}}</text>
          <text class="opp-meta-item">{{item.statusText}}</text>
        </view>
      </view>
      <view class="empty-state" wx:if="{{recentOpportunities.length === 0}}">
        <text>暂无可用机会</text>
      </view>
    </view>
  </view>
</view>
