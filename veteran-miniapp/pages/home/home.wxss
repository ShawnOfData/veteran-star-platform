.home-page {
  padding-bottom: 40rpx;
}

/* ===== Banner ===== */
.banner-swiper {
  height: 320rpx;
  margin: 20rpx 24rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.banner-item {
  height: 100%;
  background: linear-gradient(135deg, #1e2c3a 0%, #0a0f18 100%);
  border: 1px solid rgba(196,163,90,0.15);
  border-radius: 16rpx;
  display: flex;
  align-items: flex-end;
}

.banner-placeholder {
  background: linear-gradient(135deg, #2d5a27 0%, #1e2c3a 100%);
}

.banner-content {
  padding: 40rpx 32rpx;
}

.banner-title {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #c4a35a;
  letter-spacing: 4rpx;
  margin-bottom: 12rpx;
}

.banner-summary {
  display: block;
  font-size: 24rpx;
  color: rgba(255,255,255,0.5);
  letter-spacing: 2rpx;
}

/* ===== Stats ===== */
.stats-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  padding: 0 24rpx;
  margin-bottom: 32rpx;
}

.stat-card {
  background: rgba(255,255,255,0.03);
  border: 1px solid rgba(196,163,90,0.1);
  border-radius: 12rpx;
  padding: 28rpx 20rpx;
  text-align: center;
}

.stat-value {
  font-size: 44rpx;
  font-weight: 700;
  display: block;
  font-family: 'Courier New', monospace;
}

.stat-label {
  font-size: 22rpx;
  color: rgba(255,255,255,0.3);
  margin-top: 8rpx;
  display: block;
  letter-spacing: 2rpx;
}

/* ===== Quick Actions ===== */
.quick-actions {
  display: flex;
  justify-content: space-around;
  padding: 0 24rpx 32rpx;
  margin: 0 24rpx 20rpx;
  border-bottom: 1px solid rgba(255,255,255,0.04);
}

.action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.action-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1px solid rgba(196,163,90,0.15);
}
.action-icon-points { background: rgba(196,163,90,0.08); }
.action-icon-opp { background: rgba(45,90,39,0.08); }
.action-icon-rank { background: rgba(30,44,58,0.08); }
.action-icon-profile { background: rgba(196,163,90,0.05); }

.icon-text {
  font-size: 32rpx;
  color: #c4a35a;
}

.action-label {
  font-size: 22rpx;
  color: rgba(255,255,255,0.4);
  letter-spacing: 2rpx;
}

/* ===== Section ===== */
.section {
  padding: 0 24rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding: 0 8rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.section-more {
  font-size: 24rpx;
  color: rgba(196,163,90,0.5);
}

/* ===== Opportunity Card ===== */
.opportunity-card {
  margin: 0 0 16rpx;
}

.opp-title {
  font-size: 28rpx;
  font-weight: 500;
  margin-bottom: 12rpx;
}

.opp-meta {
  display: flex;
  gap: 20rpx;
}

.opp-meta-item {
  font-size: 22rpx;
  color: rgba(255,255,255,0.35);
}
