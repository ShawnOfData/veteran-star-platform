.login-page {
  min-height: 100vh;
  background: #080c14;
  display: flex;
  flex-direction: column;
  padding: 120rpx 48rpx 60rpx;
  position: relative;
  overflow: hidden;
}

.scan-line {
  position: absolute;
  left: 0;
  width: 100%;
  height: 2rpx;
  background: linear-gradient(90deg, transparent, rgba(196,163,90,0.15), transparent);
  animation: scanMove 8s linear infinite;
  pointer-events: none;
  z-index: 0;
}
@keyframes scanMove {
  0%   { top: 0; opacity: 0; }
  10%  { opacity: 1; }
  90%  { opacity: 1; }
  100% { top: 100%; opacity: 0; }
}

.login-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 80rpx;
}

.header-emblem {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(196,163,90,0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}
.emblem-img {
  width: 60rpx;
  height: 60rpx;
}

.header-title {
  font-size: 48rpx;
  font-weight: 900;
  color: #c4a35a;
  letter-spacing: 8rpx;
}

.header-sub {
  font-size: 22rpx;
  color: rgba(196,163,90,0.5);
  letter-spacing: 4rpx;
  margin-top: 12rpx;
}

.login-tabs {
  display: flex;
  border-bottom: 1px solid rgba(255,255,255,0.06);
  margin-bottom: 48rpx;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 28rpx;
  color: rgba(255,255,255,0.3);
  letter-spacing: 4rpx;
  position: relative;
}
.tab-item.active {
  color: #c4a35a;
}
.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 3rpx;
  background: #c4a35a;
}

.login-form {
  flex: 1;
}

.form-group {
  margin-bottom: 32rpx;
}

.form-label {
  display: block;
  font-size: 24rpx;
  color: rgba(255,255,255,0.4);
  margin-bottom: 12rpx;
  letter-spacing: 2rpx;
}

.form-input {
  width: 100%;
  height: 88rpx;
  background: transparent;
  border: 1px solid rgba(255,255,255,0.1);
  border-radius: 8rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: rgba(255,255,255,0.9);
  box-sizing: border-box;
}

.picker-text {
  line-height: 88rpx;
}

.login-footer {
  text-align: center;
  padding: 40rpx 0;
  font-size: 22rpx;
  color: rgba(255,255,255,0.12);
  letter-spacing: 2rpx;
}
