<view class="profile-page">
  <!-- 用户信息头 -->
  <view class="profile-header">
    <view class="profile-avatar">{{studentInitial}}</view>
    <view class="profile-info">
      <text class="profile-name">{{student.name || '未登录'}}</text>
      <text class="profile-student-no">{{student.studentNo || ''}}</text>
    </view>
    <view class="profile-points-badge">
      <text class="badge-value text-gold">{{points.total || 0}}</text>
      <text class="badge-label">积分</text>
    </view>
  </view>

  <view class="divider"></view>

  <!-- 个人信息 -->
  <view class="info-section">
    <view class="info-row">
      <text class="info-label">学号</text>
      <text class="info-value">{{student.studentNo || '-'}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">姓名</text>
      <text class="info-value">{{student.name || '-'}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">学院</text>
      <text class="info-value">{{student.college || '-'}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">专业</text>
      <text class="info-value">{{student.major || '-'}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">年级</text>
      <text class="info-value">{{student.grade || '-'}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">手机号</text>
      <text class="info-value">{{student.phone || '-'}}</text>
    </view>
  </view>

  <view class="divider"></view>

  <!-- 菜单 -->
  <view class="menu-section">
    <view class="menu-item" bindtap="goToPoints">
      <text class="menu-icon">★</text>
      <text class="menu-text">积分明细</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goToMyApplications">
      <text class="menu-icon">!</text>
      <text class="menu-text">我的报名</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goToRanking">
      <text class="menu-icon">#</text>
      <text class="menu-text">积分排行</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="editProfile">
      <text class="menu-icon">@</text>
      <text class="menu-text">编辑资料</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <view class="divider"></view>

  <!-- 退出 -->
  <button class="logout-btn" bindtap="handleLogout">退出登录</button>
</view>
