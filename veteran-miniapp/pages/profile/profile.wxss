.profile-page {
  padding-bottom: 60rpx;
}

/* ===== Header ===== */
.profile-header {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 48rpx 32rpx 32rpx;
}

.profile-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: rgba(196,163,90,0.1);
  border: 2rpx solid rgba(196,163,90,0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: #c4a35a;
  font-weight: 700;
}

.profile-info {
  flex: 1;
}

.profile-name {
  font-size: 34rpx;
  font-weight: 600;
  display: block;
}

.profile-student-no {
  font-size: 24rpx;
  color: rgba(255,255,255,0.3);
  margin-top: 6rpx;
  display: block;
}

.profile-points-badge {
  text-align: center;
}

.badge-value {
  font-size: 44rpx;
  font-weight: 900;
  display: block;
  font-family: 'Courier New', monospace;
}

.badge-label {
  font-size: 20rpx;
  color: rgba(255,255,255,0.25);
  display: block;
  margin-top: 4rpx;
  letter-spacing: 2rpx;
}

/* ===== Info ===== */
.info-section {
  padding: 16rpx 32rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1px solid rgba(255,255,255,0.03);
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 26rpx;
  color: rgba(255,255,255,0.4);
}

.info-value {
  font-size: 26rpx;
  color: rgba(255,255,255,0.8);
}

/* ===== Menu ===== */
.menu-section {
  padding: 8rpx 0;
}

.menu-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 28rpx 32rpx;
  border-bottom: 1px solid rgba(255,255,255,0.02);
}
.menu-item:active {
  background: rgba(255,255,255,0.03);
}

.menu-icon {
  width: 40rpx;
  font-size: 28rpx;
  color: #c4a35a;
  text-align: center;
}

.menu-text {
  flex: 1;
  font-size: 28rpx;
}

.menu-arrow {
  font-size: 36rpx;
  color: rgba(255,255,255,0.15);
}

/* ===== Logout ===== */
.logout-btn {
  margin: 40rpx 48rpx;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  font-size: 28rpx;
  color: rgba(255,255,255,0.4);
  background: rgba(255,255,255,0.03);
  border: 1px solid rgba(255,255,255,0.06);
  border-radius: 8rpx;
}
.logout-btn:active {
  background: rgba(255,0,0,0.05);
  border-color: rgba(255,0,0,0.15);
  color: #e74c3c;
}
