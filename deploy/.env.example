# ========================================
# 戎归·星辉 Docker 部署环境变量配置
# ========================================
# 使用方法：
#   1. 复制此文件为 .env：cp .env.example .env
#   2. 修改其中的敏感值为你的实际配置
#   3. 启动：docker compose up -d
# ========================================

# MySQL root 密码（首次启动时设置，之后不可更改，除非删除数据卷）
DB_ROOT_PASSWORD=ChangeMeToStrongPassword123

# JWT 签名密钥（至少 256 位 / 32 字符）
JWT_SECRET=yfRGxv3NjlvocLySH8FxzP9MXc6kfBAX8jf3R5zT

# AES 加密密钥和 IV（必须 16 字符，且与本地开发环境一致，否则已加密的手机号无法解密）
AES_KEY=HNb6BbXuVGvWEaWS
AES_IV=gfSuzTHRVHq2FEbL

# AI 分析配置（可选，留空则使用规则引擎兜底）
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat
